# Copy to commerce/backend/.env for local runs. Never commit .env.
COMMERCE_APP_ENV=local
COMMERCE_DATABASE_URL=postgresql+psycopg://finshop:finshop@127.0.0.1:5544/finshop_commerce
COMMERCE_WEB_ORIGIN=http://localhost:3100
COMMERCE_SOURCE_MODE=MOCK

# Strong HMAC secret (>= 32 chars in docker/production) for signing session/merchant/service tokens.
COMMERCE_AUTH_SECRET=finshop-local-only-dev-hmac-secret-key-2026-change-me
COMMERCE_SERVICE_API_KEY=finshop-local-only-service-connector-key-2026-change-me

# Optional FinResolve event delivery (Commerce operates independently when unset or offline).
FINRESOLVE_API_BASE_URL=
FINRESOLVE_SESSION_TOKEN=
FINRESOLVE_SERVICE_TOKEN=

# Reservation & worker timing
COMMERCE_RESERVATION_TTL_SECONDS=900
COMMERCE_WORKER_POLL_SECONDS=1.5
COMMERCE_MAX_REQUEST_BODY_BYTES=1048576
