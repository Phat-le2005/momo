# FinShop LIVE Commerce API — Example Environment Variables (never commit real secrets!)
COMMERCE_APP_ENV=local
COMMERCE_DATABASE_URL=postgresql+psycopg://finshop:finshop@localhost:5434/finshop_commerce
COMMERCE_WEB_ORIGIN=http://localhost:3100
COMMERCE_SOURCE_MODE=MOCK

# Security secrets (override with >=32-char random strings outside local dev)
COMMERCE_AUTH_SECRET=finshop-local-only-dev-hmac-secret-key-2026-change-me
COMMERCE_SERVICE_API_KEY=finshop-local-only-service-connector-key-2026-change-me
COMMERCE_MOCK_PROVIDER_SECRET=finshop-local-only-mock-provider-secret-2026-change-me
COMMERCE_TEST_MERCHANT_USERNAME=merchant_owner
COMMERCE_TEST_MERCHANT_PASSWORD=FinShopLocal!2026

# VNPAY Sandbox (API 2.1.0) — disabled by default until merchant credentials are provided
COMMERCE_VNPAY_ENABLED=false
COMMERCE_VNPAY_TMN_CODE=
COMMERCE_VNPAY_HASH_SECRET=
COMMERCE_VNPAY_VERSION=2.1.0
COMMERCE_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
COMMERCE_VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
COMMERCE_VNPAY_RETURN_URL=http://localhost:3100/payment/vnpay/return
COMMERCE_VNPAY_IPN_PUBLIC_URL=
COMMERCE_VNPAY_REFUND_ENABLED=false
COMMERCE_VNPAY_TIMEOUT_SECONDS=10
COMMERCE_VNPAY_PAYMENT_EXPIRY_MINUTES=15

# Restricted Public HTTPS Gateway (disabled by default)
COMMERCE_PUBLIC_GATEWAY_ENABLED=false
COMMERCE_PUBLIC_BASE_URL=

# Optional FinResolve Event Outbox Delivery
COMMERCE_FINRESOLVE_API_BASE_URL=
COMMERCE_FINRESOLVE_SESSION_TOKEN=
COMMERCE_FINRESOLVE_SERVICE_TOKEN=
