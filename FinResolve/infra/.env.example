# Copy to infra/.env to override docker-compose defaults. Never commit infra/.env.
POSTGRES_DB=finresolve
POSTGRES_USER=finresolve
POSTGRES_PASSWORD=change-me-local-only
# Host port for Postgres (5433 avoids clashing with a locally installed PostgreSQL on 5432).
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Required strong HMAC secret (>= 32 chars) for manager approval capability tokens in APP_ENV=docker/production.
DEMO_APPROVAL_SECRET=replace_with_strong_random_32_plus_char_hmac_secret_key

# Optional LLM provider (Prompt 02). Empty => DEMO_RULES (deterministic, labeled in UI).
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Standalone Supervisor worker heartbeat and lease settings (worker runs as dedicated service).
WORKER_HEARTBEAT_TTL_SECONDS=25
SUPERVISOR_JOB_LEASE_SECONDS=30
SUPERVISOR_HEARTBEAT_INTERVAL_SECONDS=5

# Independent FinShop LIVE Commerce stack (Prompt 10)
COMMERCE_POSTGRES_DB=finshop_commerce
COMMERCE_POSTGRES_USER=finshop
COMMERCE_POSTGRES_PASSWORD=change-me-commerce-local
COMMERCE_POSTGRES_PORT=5434
COMMERCE_API_PORT=8100
COMMERCE_WEB_PORT=3100
COMMERCE_WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_COMMERCE_API_BASE_URL=http://localhost:8100
COMMERCE_AUTH_SECRET=replace_with_strong_random_32_plus_char_commerce_auth_secret
COMMERCE_SERVICE_API_KEY=replace_with_strong_random_32_plus_char_commerce_service_key
