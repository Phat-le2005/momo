# Copy to infra/.env to override docker-compose defaults. Never commit infra/.env.
POSTGRES_DB=finresolve
POSTGRES_USER=finresolve
POSTGRES_PASSWORD=change-me-local-only
# Host port for Postgres (5433 avoids clashing with a locally installed PostgreSQL on 5432).
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Required strong HMAC secret (>= 32 chars) for manager approval capability tokens in APP_ENV=docker/production.
DEMO_APPROVAL_SECRET=replace_with_strong_random_32_plus_char_hmac_secret_key

# Optional LLM provider (Prompt 02). Empty => DEMO_RULES (deterministic, labeled in UI).
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Standalone Supervisor worker heartbeat and lease settings (worker runs as dedicated service).
WORKER_HEARTBEAT_TTL_SECONDS=25
SUPERVISOR_JOB_LEASE_SECONDS=30
SUPERVISOR_HEARTBEAT_INTERVAL_SECONDS=5
