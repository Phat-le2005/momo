# Copy to infra/.env to override docker-compose defaults. Never commit infra/.env.
POSTGRES_DB=finresolve
POSTGRES_USER=finresolve
POSTGRES_PASSWORD=change-me-local-only
# Host port for Postgres (5433 avoids clashing with a locally installed PostgreSQL on 5432).
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional LLM provider (Prompt 02). Empty => DEMO_RULES (deterministic, labeled in UI).
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
