# Copy to backend/.env for local (non-Docker) runs. Never commit .env.
APP_ENV=local

# PostgreSQL is the source of truth. Local-only sample credentials; change them.
DATABASE_URL=postgresql+psycopg://finresolve:change-me-local-only@localhost:5432/finresolve
DB_CONNECT_TIMEOUT_SECONDS=3

# Comma-separated explicit browser origins allowed by CORS (no "*").
WEB_ORIGIN=http://localhost:3000

# Only MOCK is supported. MOMO_SANDBOX needs authorized credentials + adapter (not built).
SOURCE_MODE=MOCK

# Strong HMAC signing secret (>= 32 chars) required in deployed environments (APP_ENV=docker/production).
DEMO_APPROVAL_SECRET=replace_with_strong_random_32_plus_char_hmac_secret_key

# Model adapter (Prompt 02 / 14.10). Leave empty => deterministic DEMO_RULES mode, labeled in UI.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_FALLBACK_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=2
MODEL_BUDGET_TOKENS=20000

# Standalone Supervisor worker is the primary execution mechanism (`python -m app.supervisor.worker`).
# Keep embedded worker disabled by default to avoid duplicate background execution.
ENABLE_EMBEDDED_SUPERVISOR_WORKER=false
WORKER_HEARTBEAT_TTL_SECONDS=15
SUPERVISOR_JOB_LEASE_SECONDS=30
SUPERVISOR_HEARTBEAT_INTERVAL_SECONDS=5

# Prompt 12 — Autonomous Continuous Commerce Monitor (`python -m app.monitoring.worker`)
CONTINUOUS_MONITOR_ENABLED=false
COMMERCE_SERVICE_BASE_URL=http://localhost:8100
COMMERCE_SERVICE_KEY=
COMMERCE_MERCHANT_ID=MERCHANT_FINSHOP_01
COMMERCE_SESSION_ID=CSESS_FINSHOP_DEFAULT_01
COMMERCE_WORLD_EPOCH=1
MONITOR_POLL_INTERVAL_SECONDS=5
MONITOR_RECONCILE_INTERVAL_SECONDS=15
MONITOR_BATCH_SIZE=50
MONITOR_LEASE_SECONDS=30
MONITOR_PAYMENT_SYNC_GRACE_SECONDS=30
MONITOR_ORDER_STALL_SECONDS=1800
MONITOR_MAX_CONCURRENT_INVESTIGATIONS=5
